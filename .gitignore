# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules

# The built site IS what gets deployed — Render serves dist/client
# directly and does not run a build, so it is committed. Everything else
# under dist/ is build scaffolding and stays ignored.
dist/*
!dist/client
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
package-lock.json

# Build output staged for preview, never committed
_dist_check.tgz
*.tgz

# Python bytecode from the content scripts
__pycache__/
*.pyc

# Razorpay credentials for the local checkout server
.env
